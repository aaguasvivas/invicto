// Cloudflare Workers config: serve the built site as static assets.
// The Git-connected build runs `npm run build` then `npx wrangler deploy`.
{
  "name": "invicto",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
