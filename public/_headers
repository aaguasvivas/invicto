# Response headers for static assets (Cloudflare Workers static assets).
# They do not apply to the /api/* responses, which the Worker builds itself.

# Vite puts a content hash in every file name under /assets/, so a changed
# file always gets a new URL. Nothing else may be immutable: HTML and
# /data/*.json keep the default revalidation so a deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font file names are not hashed: cache for a week, refresh in the background.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
