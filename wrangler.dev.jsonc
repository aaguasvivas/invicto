// Local-only config for `npx wrangler dev --config wrangler.dev.jsonc`.
// Uses a local sqlite for D1 (no Cloudflare auth needed). Production config is
// wrangler.jsonc — it gains the same `main`/`d1_databases` once the real
// database exists (see README "Global daily stats").
{
  "name": "invicto",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "invicto-stats", "database_id": "local-placeholder" }
  ]
}
